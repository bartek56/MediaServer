        <file>icons/samba.png</file>
        <file>icons/ftp.png</file>
        <file>icons/multimedia.png</file>
        <file>icons/settings.png</file>
        <file>icons/pcmanfm.png</file>
        <file>icons/poweroff.png</file>
        <file>icons/qnapi.png</file>
        <file>icons/quotes.png</file>
        <file>ScreenSaverManager.qml</file>
        <file>ScreenSaver.qml</file>
        <file>Napi.qml</file>
        <file alias="MediaFileDialog.qml">../../qml/MediaFileDialog.qml</file>
        <file alias="MediaFileDialogQt5.qml">../../qml/MediaFileDialogQt5.qml</file>
        <file alias="MediaFileDialogQt6.qml">../../qml/MediaFileDialogQt6.qml</file>
